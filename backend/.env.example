PORT=3000

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ourlovemap

# InfinitePay
INFINITEPAY_HANDLE=your-infinitetag-without-dollar
INFINITEPAY_WEBHOOK_SECRET=your-webhook-secret

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=ourlovemap-photos
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Resend
RESEND_API_KEY=your-resend-api-key

# URLs
OURLOVEMAP_BASE_URL=https://ourlovemap.com
OURLOVEMAP_API_URL=https://api.ourlovemap.com

# Observabilidade (opcionais em dev)
POSTHOG_API_KEY=phc_your-posthog-key
NODE_ENV=production
